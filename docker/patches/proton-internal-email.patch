+def _is_proton_internal_candidate(msg: email_lib.message.Message, sender_addr: str) -> bool:
+    """Only trust these Proton-stamped headers on an explicitly opted-in Bridge connection.
+
+    Proton must strip/replace external copies; encryption alone is not sender authentication.
+    A present Authentication-Results verdict is never overridden, even if empty or malformed.
+    """
+    if msg.get_all("Authentication-Results") is not None:
+        return False
+    from_headers = msg.get_all("From", [])
+    if len(from_headers) != 1:
+        return False
+    addresses = getaddresses(from_headers)
+    if len(addresses) != 1 or not addresses[0][1] or addresses[0][1].lower() != sender_addr:
+        return False
+    return all(
+        len(values := msg.get_all(name, [])) == 1 and values[0].strip().lower() == expected
+        for name, expected in (("X-Pm-Origin", "internal"), ("X-Pm-Content-Encryption", "end-to-end"))
+    )
+
